{
  "name": "league-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Windows overlay coach for League of Legends: draft suggestions, objective timers, build and skill reminders.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "start:mock": "npm run build && cross-env LIVE_CLIENT_URL=http://127.0.0.1:2999 electron .",
    "mock": "node scripts/mock-live-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "kokoro-js": "^1.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "dev.leaguecoach.app",
    "productName": "League Coach",
    "files": [
      "dist/**/*",
      "static/**/*",
      "config.example.json"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/kokoro-js/voices/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
